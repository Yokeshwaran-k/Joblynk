generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  WORKER
  EMPLOYER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())

  name         String
  email        String   @unique
  phone        String   @unique
  password     String
  role         UserRole

  skill        String?
  dailyWage    Int?
  experience   Int?
  address      String?
  pincode      String?
  district     String?
  state        String?
  latitude     Float?
  longitude    Float?
  profileImage String?
  isAvailable  Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  postedJobs   Job[] @relation("EmployerJobs")
  acceptedJobs Job[] @relation("AssignedWorker")
}

model Job {
  id          Int       @id @default(autoincrement())

  title       String
  description String

  skill       String
  budget      Int

  address     String
  pincode     String
  district    String
  state       String

  workDate    DateTime

  status      JobStatus @default(OPEN)

  employerId  Int
  employer    User @relation("EmployerJobs", fields: [employerId], references: [id])

  workerId    Int?
  worker      User? @relation("AssignedWorker", fields: [workerId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([skill])
  @@index([pincode])
  @@index([status])
}

enum JobStatus {
  OPEN
  ACCEPTED
  COMPLETED
  CANCELLED
}