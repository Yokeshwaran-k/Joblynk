generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  WORKER
  EMPLOYER
  ADMIN
}

model User {
  id         Int       @id @default(autoincrement())
  name       String
  email      String    @unique
  phone      String    @unique
  password   String
  role       UserRole

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}